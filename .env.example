# The scanner and watermark tools need no .env file.
# Optional public Sepolia settings for the browser's read-only proof lookup.
# Copy to .env only if you need a shared registry address or a different RPC.
VITE_SEPOLIA_REGISTRY_ADDRESS=
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# VITE_ values are visible in the browser. Never put keys or mnemonics here.
